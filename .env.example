# Variables de entorno para LinSolve
# Copiar este archivo a .env y completar los valores

# NVIDIA NIM Configuración (Capa LLM)
NVIDIA_API_KEY=nvapi-tu-key
# 1. Extracción de Modelo (Text-to-Math)
NVIDIA_EXTRACT_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_EXTRACT_MODEL=deepseek-ai/deepseek-v4-flash
# 2. Análisis de Negocio (Math-to-Business)
NVIDIA_ANALYSIS_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_ANALYSIS_MODEL=deepseek-ai/deepseek-v4-pro

# Orígenes permitidos para CORS (separados por coma)
ALLOWED_ORIGINS=http://localhost:4321,http://localhost:3000,https://linsolve.app

# Rate limiting (formato: número/periodo)
RATE_LIMIT=10/minute

# Nivel de logging (DEBUG para desarrollo, INFO para producción)
LOG_LEVEL=INFO

# Entorno (development, production)
ENVIRONMENT=development

# URL del backend (para el BFF de Astro)
PUBLIC_BACKEND_URL=http://localhost:8000